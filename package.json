{
  "name": "fantasy-league-assistant",
  "version": "1.0.0",
  "description": "Discord bot for viewing Sleeper fantasy football league information via slash commands.",
  "main": "dist/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "deploy:commands": "tsx src/deploy-commands.ts",
    "lint": "eslint src",
    "test": "tsx src/services/draftGradeService.test.ts",
    "format": "prettier --write --ignore-unknown \"src/**/*.ts\" \"supabase/**/*.sql\" \"*.md\""
  },
  "keywords": [
    "discord",
    "discord-bot",
    "sleeper",
    "fantasy-football"
  ],
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.110.1",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "openai": "^7.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "eslint": "^10.6.0",
    "prettier": "^3.9.4",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  }
}
