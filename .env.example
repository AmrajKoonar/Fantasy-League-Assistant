# Discord bot token from https://discord.com/developers/applications -> Bot -> Token
DISCORD_TOKEN=

# Discord application (client) ID from https://discord.com/developers/applications -> General Information
DISCORD_CLIENT_ID=

# The Discord server (guild) ID where slash commands are registered during development.
# Enable Developer Mode in Discord, right-click your server, "Copy Server ID".
DISCORD_GUILD_ID=

# Supabase project URL from https://supabase.com/dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service role key (server-side only, never expose publicly)
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI draft-grade integrations. The bot starts without these,
# but /create_draft_grades requires all three keys/model settings.
FANTASYPROS_API_KEY=
FANTASYPROS_BASE_URL=https://api.fantasypros.com/public/v2/json
FANTASYPROS_DEFAULT_RANKING_TYPE=DRAFT
OPENAI_API_KEY=
OPENAI_MODEL=

NODE_ENV=production
